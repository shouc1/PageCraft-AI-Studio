# ============================================================
# 页匠 AI｜PageCraft AI Studio — 环境变量模板
# 复制本文件为 .env 并填入真实凭证：cp .env.example .env
# 注意：设置页修改的值优先于本文件；清空设置页自定义值即回落到这里
# ============================================================

# === 模型厂商选择 ===
# 语言模型：doubao（豆包 ARK）/ qwen（千问 DashScope）
LLM_PROVIDER=doubao
# 视觉模型（生图）：jimeng（即梦火山签名）/ qwen（千问 DashScope）
IMAGE_PROVIDER=jimeng
# 两组均可登录前端设置页运行时切换，无需重启

# === 火山引擎 IAM（即梦生图用；IMAGE_PROVIDER=jimeng 时必填） ===
# 在 https://console.volcengine.com/iam/keymanage/ 创建
VOLCENGINE_AK=
VOLCENGINE_SK=
# 即梦模型 req_key（按 workflow 区分，可在设置页覆盖）
JIMENG_T2I_MODEL=
JIMENG_I2I_MODEL=

# === 豆包 ARK（LLM 用，OpenAI 兼容接口；LLM_PROVIDER=doubao 时必填） ===
# 在 ARK 控制台「API 接入」页面创建 API Key
ARK_API_KEY=
# 推理接入点 ID（ep- 开头）
DOUBAO_MODEL=

# === 阿里云百炼 DashScope（千问文本/生图共用；任一 provider=qwen 时必填） ===
DASHSCOPE_API_KEY=
# 千问 LLM 走 OpenAI 兼容地址；业务空间专属域名形如
# https://ws-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_BASE_URL=
QWEN_TEXT_MODEL=
# 千问生图地址；业务空间专属域名形如
# https://ws-xxx.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
QWEN_IMAGE_MODEL=

# === 服务配置 ===
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
